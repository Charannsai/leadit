# ── Database (required) ─────────────────────────────────────────────
# Supabase → Project settings → API. The service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI models ───────────────────────────────────────────────────────
# Enrichment agent (reads websites, matches founders): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Drafting agent (writes outreach): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Either agent can be switched to the other provider in Settings → Agents.

# ── Enrichment data sources (all have free tiers) ───────────────────
# Web + LinkedIn search: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Email finder + verification: https://hunter.io/api-keys
HUNTER_API_KEY=
# Company profiles, optional: https://app.apollo.io
APOLLO_API_KEY=

# ── Outreach ────────────────────────────────────────────────────────
# Verify your sending domain in Resend first: https://resend.com/api-keys
RESEND_API_KEY=

# ── App ─────────────────────────────────────────────────────────────
# Any long random string. Lets the background worker call itself.
WORKER_SECRET=
# Set this before deploying: the dashboard then asks for a password.
APP_PASSWORD=
# Vercel Cron sends this to /api/worker (set it in Vercel too).
CRON_SECRET=

# Keys can also be added or rotated later in Settings → API keys (stored in your database).
